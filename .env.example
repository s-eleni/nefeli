# Anthropic Claude API Key (required for LLM analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Maps API Key (required for distance calculation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Gmail SMTP credentials (required for email alerts)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# RentCast API Key (optional - sign up at https://www.rentcast.io/api)
RENTCAST_API_KEY=

# Flask settings
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=false

# Scraper settings
SCRAPER_DELAY_MIN=2
SCRAPER_DELAY_MAX=5
